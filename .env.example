# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Journal

# ─── Supabase Postgres ────────────────────────────────────────────────
# Supabase Dashboard → Project → Connect → ORMs
# Transaction pooler (port 6543) – used by the app at runtime (Vercel)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Session pooler / direct (port 5432) – used by drizzle-kit migrations
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Auth (Better Auth) ───────────────────────────────────────────────
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Email OTP via Nodemailer (SMTP) ──────────────────────────────────
# Gmail example: smtp.gmail.com / 465 / your Gmail + an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Journal <your-address@gmail.com>"

# ─── Encryption for stored broker credentials ─────────────────────────
# generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── MetaApi (MT5 cloud sync) ─────────────────────────────────────────
METAAPI_TOKEN=

# SMC Desk (optional): server behind a tunnel. Key/secret match smc-desk/server/.env ACCESS_KEY / WS_TOKEN_SECRET.
SMC_API_URL=
SMC_ACCESS_KEY=
SMC_WS_SECRET=

# ─── Gemini (AI insights, free tier) ──────────────────────────────────
GEMINI_API_KEY=
# Optional. Default: gemini-flash-latest (always Google's current Flash model)
GEMINI_MODEL=

# ─── Supabase Storage (trade screenshots) ─────────────────────────────
# Create a PRIVATE bucket named below in Supabase → Storage.
# The service-role key stays on the server only (never NEXT_PUBLIC_).
SUPABASE_URL=https://[project-ref].supabase.co
# Project Settings → API Keys → "Secret key" (sb_secret_...) or the legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trade-images

# ─── Cron (Vercel) ────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily.
# generate: openssl rand -base64 32
CRON_SECRET=

# ─── Economic calendar ────────────────────────────────────────────────
# Optional. Comma-separated weekly calendar JSON feeds (ForexFactory format).
# Default: ForexFactory's public this-week + next-week feeds.
NEWS_FEED_URLS=
